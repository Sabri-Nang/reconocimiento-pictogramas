# Entorno virtual
.venv/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Editores
.vscode/
.idea/

# Archivos temporales
tmp/
*.log

# Datos: conservar carpetas, ignorar su contenido
data/raw/**
data/processed/**
data/splits/**
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/splits/.gitkeep

# Modelos entrenados
models/**
!models/.gitkeep

# Gráficos generados
reports/figures/**
!reports/figures/.gitkeep

# Sistema operativo
.DS_Store
Thumbs.db
# Artefactos locales regenerables de auditoría y preparación
/reports/dataset_preparation_backups/
/reports/dataset_10_audit/contact_sheets/

# Estado transitorio de las ejecuciones de validación cruzada
/reports/cv*/progress.json

# Capturas de comprobación de cámara (contienen imágenes del dataset)
/reports/live_camera_smoke/*.png
# Credenciales y certificados locales de acceso móvil
.runtime/

# Estado local de Gradio y certificados generados
/.gradio/

# Hojas de contacto regenerables; conservar las copias locales
/reports/revision_visual/*.jpg
/reports/revision_visual/*.png

# Hojas visuales de nuevas sesiones: copias locales regenerables
/reports/session_s008_review/contact_sheets/

# Copias locales duplicadas; conservar evidencia estructurada y PDF final en Git
/data/metadata_antes_*.csv
/reports/auditoria_s007_*/contact_sheets/
/reports/auditoria_unknown_s007_*/contacto.jpg
/reports/mobilenet_app_192_20261020/progress.json
